{
  "name": "kypstamping-frontends",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:business": "npm run dev --workspace @kypstamping/business-web",
    "dev:admin": "npm run dev --workspace @kypstamping/admin-web",
    "dev:customer": "npm run dev --workspace @kypstamping/customer-pwa",
    "dev:marketing": "npm run dev --workspace @kypstamping/marketing-site",
    "dev:marketplace": "npm run dev --workspace @kypstamping/marketplace",
    "build": "npm run build --workspaces --if-present",
    "audit:controls": "node scripts/audit-controls.mjs",
    "test:format": "node scripts/test-format.mjs",
    "qa:customer-auth": "node scripts/qa-customer-auth.mjs",
    "qa:private-apps": "node scripts/qa-private-apps.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages",
    "test": "npm run test --workspaces --if-present",
    "sweep": "node tools/sweep.mjs",
    "qa:merchant": "node scripts/qa-merchant.mjs",
    "qa:wallet": "node scripts/qa-customer.mjs",
    "qa:edges": "node scripts/qa-deep.mjs",
    "qa:tenants": "node scripts/qa-tenants.mjs",
    "qa:refusals": "node scripts/qa-refusals.mjs",
    "qa:marketing": "node scripts/qa-marketing.mjs",
    "qa:marketplace": "node scripts/qa-marketplace.mjs",
    "qa:free-tier": "node scripts/qa-free-tier.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.3.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "latest",
    "playwright": "^1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
