# Copy to .env.local in each app (or to .env at this root for the compose
# stack). Never commit a real .env.

# Where each app reaches the API: the absolute API root, set per Vercel
# project. There is no same-origin rewrite, so it is never empty. One API
# service answers on two hostnames, and each app uses the one on its own site
# so the SameSite=Lax session cookie stays first-party:
#
#   marketing-site, business-web, admin-web   https://api.kyprewards.com/api/v1
#   customer-pwa, marketplace                 https://api.kyp.ph/api/v1
#
# A wallet on app.kyp.ph calling api.kyprewards.com would be cross-site:
# browsers that block third-party cookies (Safari by default) drop the
# session and sign-in fails with nothing in the network tab.
#
# NEXT_PUBLIC_ values are inlined at build time. Changing this after a build
# does nothing to an already-deployed bundle.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Cross-links between the apps, already read by marketing-site/src/lib/site.ts.
NEXT_PUBLIC_BUSINESS_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Google Analytics 4 measurement id, set only on the two public sites:
# marketing-site (kyprewards.com) and marketplace (kyp.ph), each with its own
# id. Leave empty to disable analytics entirely; when set, the tag still loads
# only after the visitor allows it (see /cookies on each site). Never set it
# on customer-pwa, business-web or admin-web: they never load GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry error monitoring, all five Next apps. Empty means Sentry stays off
# and the SDK is never loaded. Personal data is not sent (dataCollection off:
# no IP, cookies, headers, bodies or query strings), one trace in ten, no
# replay, no source-map upload
# (packages/ui/src/sentry.ts). Two DSNs, set per Vercel project and never
# written into code:
#   customer-pwa, marketplace                    -> the kyp.ph project DSN
#   marketing-site, business-web, admin-web      -> the kyprewards project DSN
NEXT_PUBLIC_SENTRY_DSN=
# production, preview or development; empty lets Sentry use its default.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# kyp.ph, the marketplace. Read by apps/marketplace/src/lib/site.ts.
NEXT_PUBLIC_MARKETPLACE_URL=

# Preview mode, local only. When "true", a screen whose endpoint the API does
# not serve yet renders typed sample data under a "Preview, not connected"
# badge, with its writes disabled. Leave EMPTY in production.
NEXT_PUBLIC_PREVIEW_UNBUILT=

# Google sign-in on the customer wallet (app.kyp.ph) only: the OAuth "Web
# application" client ID from console.cloud.google.com, project kyp-ph, with
# the wallet's origins listed as authorised JavaScript origins. Empty hides
# the button. The API must list the same ID in GOOGLE_CLIENT_IDS.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
