# Copy to .env.local in each app (or to .env at this root for the compose
# stack). Never commit a real .env.

# Where the four apps reach the API.
#
# Leave EMPTY in production and put the API behind a same-origin path, so the
# session cookie is same-site and no CORS preflight runs on every call. Set it
# to the absolute API root when that is not possible - and then the backend
# needs SESSION_COOKIE_SAMESITE=none, or the browser drops the cookie and
# every authenticated call answers 401.
#
# NEXT_PUBLIC_ values are inlined at build time. Changing this after a build
# does nothing to an already-deployed bundle.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Cross-links between the apps, already read by marketing-site/src/lib/site.ts.
NEXT_PUBLIC_BUSINESS_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3003
