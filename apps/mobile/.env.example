# Copy to .env for a local run. Every value is inlined into the JS bundle at
# build time, so nothing secret goes here - the same rule as NEXT_PUBLIC_.
# Without a .env the app talks to production (src/lib/config.ts).
#
# The Android emulator reaches the host at 10.0.2.2. A phone on USB reaches it
# as localhost after `adb reverse tcp:8000 tcp:8000`. A phone on the LAN
# cannot reach either; use the machine's IPv4 from `ipconfig`.
EXPO_PUBLIC_API_BASE=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_MARKETPLACE_URL=https://kyp.ph
EXPO_PUBLIC_SITE_URL=https://kyprewards.com

# Google sign-in. The web client ID (the same one app.kyp.ph uses) makes
# Google return an ID token; the iOS client ID is iOS's own. Empty hides the
# button. Store builds take these from the EAS environment, not this file.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
