# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native folders are generated by `expo prebuild`; EAS builds from app.json.
ios/
android/

# Metro
.metro-health-check*

# Local env: EXPO_PUBLIC_* for a device on the LAN. See src/lib/config.ts.
.env
.env.local

# Credentials, by location rather than by name. Firebase names a service
# account key "<project>-firebase-adminsdk-<hash>-<hash>.json", so an
# anchored pattern misses it and the key gets committed - which is exactly
# what happened to the first version of this rule. A directory cannot be
# outsmarted by a filename. Put the FCM V1 key here; it goes to EAS with
# `eas credentials` and never into git.
credentials/*
!credentials/README.md

# Belt and braces, unanchored this time.
*firebase-adminsdk*.json
*service-account*.json

# `google-services.json` is deliberately NOT ignored: it is not a secret, it
# ships inside the APK, and EAS Build needs it in the tree.
