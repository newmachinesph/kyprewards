{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://10.0.2.2:8000/api/v1",
        "EXPO_PUBLIC_MARKETPLACE_URL": "http://10.0.2.2:3004",
        "EXPO_PUBLIC_SITE_URL": "http://10.0.2.2:3003"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.kyp.ph/api/v1",
        "EXPO_PUBLIC_MARKETPLACE_URL": "https://kyp.ph",
        "EXPO_PUBLIC_SITE_URL": "https://kypstamping.ph"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.kyp.ph/api/v1",
        "EXPO_PUBLIC_MARKETPLACE_URL": "https://kyp.ph",
        "EXPO_PUBLIC_SITE_URL": "https://kypstamping.ph"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
