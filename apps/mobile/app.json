{
  "expo": {
    "name": "KYP",
    "slug": "kyp",
    "owner": "sumnora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kyp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf8f3",
    "ios": {
      "bundleIdentifier": "ph.kyp.wallet",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:app.kyp.ph",
        "applinks:kyp.ph"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "KYP uses the camera to scan a shop's counter poster and join its card.",
        "NSLocationWhenInUseUsageDescription": "KYP uses your location only while the app is open, to list the shops nearest you first. It is never shared with a shop.",
        "NSFaceIDUsageDescription": "KYP can lock your wallet behind Face ID if you turn that on.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "ph.kyp.wallet",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#faf8f3"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.kyp.ph",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "app.kyp.ph",
              "pathPrefix": "/login"
            },
            {
              "scheme": "https",
              "host": "app.kyp.ph",
              "pathPrefix": "/feedback"
            },
            {
              "scheme": "https",
              "host": "kyp.ph",
              "pathPrefix": "/shops"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.WRITE_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "KYP uses the camera to scan a shop's counter poster and join its card.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KYP uses your location only while the app is open, to list the shops nearest you first."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e8a33d",
          "defaultChannel": "rewards"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#faf8f3"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Reanimated and worklets are reached from C++ by name; R8 cannot see those calls.\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64622711-d686-4193-bcb2-9b8fb8abaa28"
      }
    }
  }
}
